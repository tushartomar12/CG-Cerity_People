# Public site origin used in metadata, sitemap, robots, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.ceritypeople.com

# PostgreSQL (pooled URL for the app; direct URL for migrations)
DATABASE_URL=
DIRECT_URL=

# SMTP (Nodemailer). Swap lib/email.ts later for SES/Resend.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
SALES_TEAM_EMAIL=
EMAIL_REPLY_TO_PEOPLE=

# Optional: reserved if you switch lib/email.ts to Resend
EMAIL_PROVIDER_API_KEY=

# Salt for hashed IPs (never store raw IPs)
IP_HASH_SALT=
